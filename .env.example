# Salin menjadi .env. Nilai ini hanya untuk pengembangan lokal.

# Database
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_local_only
POSTGRES_DB=geoentity
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://geo:geo_local_only@db:5432/geoentity?sslmode=disable
HTTP_ADDR=:8080
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Test integrasi. Nama database wajib berakhiran _test.
# Dijalankan dari mesin host, sehingga memakai localhost, bukan service db.
TEST_DATABASE_URL=postgres://geo:geo_local_only@localhost:5432/geoentity_test?sslmode=disable

# Frontend
FRONTEND_PORT=5173
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
