{
  "_comment": "Rules from docs/PRD.md section 5, run by the Go and Vitest tests. Each case changes a valid entity. A null removes the value. {\"$repeat\": text, \"count\": n} repeats text, and {\"$attributes\": n} makes n attributes. \"frontend\": false marks values a form cannot produce.",
  "valid": {
    "name": "Truk Logistik",
    "type": "vehicle",
    "status": "active",
    "latitude": -6.9175,
    "longitude": 107.6191
  },
  "accepted": [
    { "name": "only required fields", "change": {} },
    { "name": "name of 100 characters", "change": { "name": { "$repeat": "a", "count": 100 } } },
    { "name": "name of 100 multibyte characters", "change": { "name": { "$repeat": "é", "count": 100 } } },
    { "name": "name of 100 emoji", "change": { "name": { "$repeat": "😀", "count": 100 } } },
    { "name": "name with spaces around it", "change": { "name": "  Truk  " } },
    { "name": "type vehicle", "change": { "type": "vehicle" } },
    { "name": "type iot_device", "change": { "type": "iot_device" } },
    { "name": "type facility", "change": { "type": "facility" } },
    { "name": "type other", "change": { "type": "other" } },
    { "name": "status active", "change": { "status": "active" } },
    { "name": "status inactive", "change": { "status": "inactive" } },
    { "name": "status maintenance", "change": { "status": "maintenance" } },
    { "name": "empty description", "change": { "description": "" } },
    { "name": "description of 500 characters", "change": { "description": { "$repeat": "a", "count": 500 } } },
    { "name": "no attributes", "change": { "attributes": {} } },
    { "name": "20 attributes", "change": { "attributes": { "$attributes": 20 } } },
    { "name": "attribute key of 50 characters", "change": { "attributes": { "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk": "v" } } },
    { "name": "attribute key with every allowed symbol", "change": { "attributes": { "aZ0_.-": "v" } } },
    { "name": "empty attribute value", "change": { "attributes": { "key": "" } } },
    { "name": "attribute value of 200 characters", "change": { "attributes": { "key": { "$repeat": "v", "count": 200 } } } },
    { "name": "zero coordinates", "change": { "latitude": 0, "longitude": 0 } },
    { "name": "largest coordinates", "change": { "latitude": 90, "longitude": 180 } },
    { "name": "smallest coordinates", "change": { "latitude": -90, "longitude": -180 } }
  ],
  "rejected": [
    { "name": "name missing", "change": { "name": null }, "field": "name", "code": "required" },
    { "name": "name empty", "change": { "name": "" }, "field": "name", "code": "required" },
    { "name": "name blank", "change": { "name": "   " }, "field": "name", "code": "required" },
    { "name": "name of 101 characters", "change": { "name": { "$repeat": "a", "count": 101 } }, "field": "name", "code": "too_long" },
    { "name": "name of 101 emoji", "change": { "name": { "$repeat": "😀", "count": 101 } }, "field": "name", "code": "too_long" },
    { "name": "name not text", "change": { "name": 123 }, "field": "name", "code": "invalid_type", "frontend": false },
    { "name": "type missing", "change": { "type": null }, "field": "type", "code": "required" },
    { "name": "type empty", "change": { "type": "" }, "field": "type", "code": "required" },
    { "name": "type unknown", "change": { "type": "spaceship" }, "field": "type", "code": "invalid_enum" },
    { "name": "type in the wrong case", "change": { "type": "VEHICLE" }, "field": "type", "code": "invalid_enum" },
    { "name": "type not text", "change": { "type": true }, "field": "type", "code": "invalid_type", "frontend": false },
    { "name": "status missing", "change": { "status": null }, "field": "status", "code": "required" },
    { "name": "status empty", "change": { "status": "" }, "field": "status", "code": "required" },
    { "name": "status unknown", "change": { "status": "lost" }, "field": "status", "code": "invalid_enum" },
    { "name": "status not text", "change": { "status": 1 }, "field": "status", "code": "invalid_type", "frontend": false },
    { "name": "description of 501 characters", "change": { "description": { "$repeat": "a", "count": 501 } }, "field": "description", "code": "too_long" },
    { "name": "description not text", "change": { "description": 1 }, "field": "description", "code": "invalid_type", "frontend": false },
    { "name": "attributes not an object", "change": { "attributes": ["a"] }, "field": "attributes", "code": "invalid_type", "frontend": false },
    { "name": "21 attributes", "change": { "attributes": { "$attributes": 21 } }, "field": "attributes", "code": "too_many" },
    { "name": "attribute key with a space", "change": { "attributes": { "a b": "v" } }, "field": "attributes.a b", "code": "invalid_format" },
    { "name": "attribute key empty", "change": { "attributes": { "": "v" } }, "field": "attributes.", "code": "invalid_format" },
    { "name": "attribute key of 51 characters", "change": { "attributes": { "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk": "v" } }, "field": "attributes.kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk", "code": "invalid_format" },
    { "name": "attribute key with a slash", "change": { "attributes": { "a/b": "v" } }, "field": "attributes.a/b", "code": "invalid_format" },
    { "name": "attribute value not text", "change": { "attributes": { "count": 5 } }, "field": "attributes.count", "code": "invalid_type", "frontend": false },
    { "name": "attribute value of 201 characters", "change": { "attributes": { "key": { "$repeat": "v", "count": 201 } } }, "field": "attributes.key", "code": "too_long" },
    { "name": "latitude missing", "change": { "latitude": null }, "field": "latitude", "code": "required" },
    { "name": "latitude above range", "change": { "latitude": 90.1 }, "field": "latitude", "code": "out_of_range" },
    { "name": "latitude below range", "change": { "latitude": -90.1 }, "field": "latitude", "code": "out_of_range" },
    { "name": "latitude not a number", "change": { "latitude": "north" }, "field": "latitude", "code": "invalid_type" },
    { "name": "longitude missing", "change": { "longitude": null }, "field": "longitude", "code": "required" },
    { "name": "longitude above range", "change": { "longitude": 180.1 }, "field": "longitude", "code": "out_of_range" },
    { "name": "longitude below range", "change": { "longitude": -180.1 }, "field": "longitude", "code": "out_of_range" },
    { "name": "longitude not a number", "change": { "longitude": "east" }, "field": "longitude", "code": "invalid_type" }
  ]
}
